// 工程级编译配置。令牌源 tokens/ 由 scripts/link-tokens.mjs 同步（生成物）。
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        // 模块 target 只接受 name / applyToProducts；runtimeOS 属于 product 层，写在这里会触发 schema 校验失败。
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
